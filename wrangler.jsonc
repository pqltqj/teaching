{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biology-review-bank",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "routes": [
    {"pattern": "ejosey.ca", "custom_domain": true},
    {"pattern": "www.ejosey.ca", "custom_domain": true},
    {"pattern": "josey.fun/*", "zone_name": "josey.fun"}
  ],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "REVIEW", "class_name": "ReviewBank"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReviewBank"]}]
}

